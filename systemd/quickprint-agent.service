[Unit]
Description=QuickPrint Pi Print Agent
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=simple
User=quickprint
Group=quickprint
# Allow CUPS socket access on Debian/Raspberry Pi OS (adjust per distro if needed)
SupplementaryGroups=lp
WorkingDirectory=/opt/quickprint-pi-agent
EnvironmentFile=/opt/quickprint-pi-agent/.env
ExecStart=/opt/quickprint-pi-agent/.venv/bin/python -m app.main
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Hardening (adjust if needed for CUPS)
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
