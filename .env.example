AGENT_ENV=development
# ENVIRONMENT=development

AGENT_ID=
AGENT_SECRET=
# AGENT_TOKEN=

BACKEND_URL=
# BACKEND_API_URL=
BACKEND_WS_URL=

JOB_DIRECTORY=jobs
DATABASE_PATH=data/agent.db

# mock = no CUPS required (Mac/dev). cups = real CUPS queue on the Pi.
PRINTER_MODE=mock
# Canonical CUPS queue name (use this):
CUPS_PRINTER_NAME=
# Legacy aliases — only read if CUPS_PRINTER_NAME is empty:
# PRINTER_NAME=
# CUPS_PRINTER=
# CUPS_SERVER=localhost
# Leave CUPS_SERVER empty for local CUPS socket (default on Pi).

LOG_LEVEL=INFO

MAX_DOWNLOAD_BYTES=52428800
# DOWNLOAD_MAX_BYTES=52428800
MOCK_PRINT_DELAY_SECONDS=0.1
MOCK_PRINT_FAILURE=false

DOWNLOAD_TIMEOUT_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=30
HEALTH_REFRESH_INTERVAL_SECONDS=60
WS_RECONNECT_MAX_DELAY_SECONDS=60

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
CUPS_COMMAND_TIMEOUT_SECONDS=30
JOB_POLL_INTERVAL_SECONDS=1.0

# --- Kiosk display (separate .env.display on Pi; NOT used by print agent) ---
# KIOSK_CODE=KIOSK-001
# KIOSK_DISPLAY_NAME=Development Kiosk
# API_URL=https://quickprint.fun
# DISPLAY_URL=https://quickprint.fun/kiosk/KIOSK-001
# DISPLAY_TOKEN=<read-only token from: bun run kiosk:seed --rotate-display-token>

# --- CUPS production example (uncomment on Pi) ---
# PRINTER_MODE=cups
# CUPS_PRINTER_NAME=quickprint-test
# CUPS_SERVER=localhost
