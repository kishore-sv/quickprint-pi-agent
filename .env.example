AGENT_ENV=development
# ENVIRONMENT=development

AGENT_ID=
AGENT_SECRET=
# AGENT_TOKEN=

BACKEND_URL=
# BACKEND_API_URL=
BACKEND_WS_URL=

JOB_DIRECTORY=jobs
DATABASE_PATH=data/agent.db

# mock = no CUPS required (Mac/dev). cups = real CUPS queue on the Pi.
PRINTER_MODE=mock
# Canonical CUPS queue name (use this):
CUPS_PRINTER_NAME=
# Legacy aliases — only read if CUPS_PRINTER_NAME is empty:
# PRINTER_NAME=
# CUPS_PRINTER=
# Leave CUPS_SERVER empty for local CUPS Unix socket on Pi (recommended).
# Do NOT set CUPS_SERVER=localhost — that forces TCP and often breaks lpstat/CUPS probing.

LOG_LEVEL=INFO

MAX_DOWNLOAD_BYTES=52428800
# DOWNLOAD_MAX_BYTES=52428800
MOCK_PRINT_DELAY_SECONDS=0.1
MOCK_PRINT_FAILURE=false

DOWNLOAD_TIMEOUT_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=30
HEALTH_REFRESH_INTERVAL_SECONDS=60
WS_RECONNECT_MAX_DELAY_SECONDS=60

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
CUPS_COMMAND_TIMEOUT_SECONDS=30
JOB_POLL_INTERVAL_SECONDS=1.0

# --- Raspberry Pi production example (generated by scripts/setup_pi.sh) ---
# AGENT_ENV=production
# AGENT_ID=REPLACE_WITH_AGENT_ID
# AGENT_SECRET=REPLACE_WITH_AGENT_SECRET
# BACKEND_URL=https://qpapi.mmkerp.shop
# BACKEND_WS_URL=wss://qpapi.mmkerp.shop/ws/kiosk
# PRINTER_MODE=cups
# CUPS_PRINTER_NAME=quickprint-test
# CUPS_SERVER=

# --- Kiosk display (separate .env.display on Pi; NOT used by print agent) ---
# See config/display.env.example — copied to .env.display by scripts/setup_pi.sh
# KIOSK_CODE=QP-KIOSK-001
# KIOSK_DISPLAY_NAME=QuickPrint Kiosk 1
# API_URL=https://qpapi.mmkerp.shop
# DISPLAY_URL=https://qp.mmkerp.shop/kiosk/QP-KIOSK-001
# DISPLAY_TOKEN=REPLACE_WITH_DISPLAY_TOKEN

# --- CUPS production example (uncomment on Pi) ---
# PRINTER_MODE=cups
# CUPS_PRINTER_NAME=quickprint-test
# CUPS_SERVER=
